generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (NextAuth.js v5 required tables) ──────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core domain ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  subjectProfiles SubjectProfile[]
  orders          Order[]
}

model SubjectProfile {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           SubjectType
  birthday       DateTime?
  ageYears       Int?
  preferenceTags String[]
  createdAt      DateTime    @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

enum SubjectType {
  child
  pet
  adult
}

model Template {
  id              String       @id @default(cuid())
  category        Category
  name            String
  description     String?
  stylePreviewUrl String?
  occasionTags    String[]
  requiredAssets  AssetType[]
  price           Int // in cents; 0 = free
  durationTier    DurationTier
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  orders Order[]
}

enum Category {
  toddler
  kids
  adult_fun
  pet
}

enum AssetType {
  photo
  voice
}

enum DurationTier {
  short // tens of seconds — quick share
  medium // a few minutes — bedtime story etc.
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  templateId       String
  subjectProfileId String?
  formData         Json // snapshot of questionnaire answers
  status           OrderStatus @default(pending_payment_or_trial)
  amountCents      Int         @default(0)
  isFreeTrial      Boolean     @default(false)
  // COPPA: logged timestamp of parental consent (required when subject is a child < 13)
  coppaConsentAt    DateTime?
  portraitConsentAt DateTime?
  // Phase 2 placeholder — no logic yet
  hasPhotographyService Boolean @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  template       Template        @relation(fields: [templateId], references: [id])
  subjectProfile SubjectProfile? @relation(fields: [subjectProfileId], references: [id])
  generationTask GenerationTask?
  reviewRecords  ReviewRecord[]
  ticket         Ticket?
}

enum OrderStatus {
  pending_payment_or_trial
  queued
  generating
  pending_review
  pending_user_confirmation
  delivered
  completed
  in_dispute
  cancelled
}

model GenerationTask {
  id           String           @id @default(cuid())
  orderId      String           @unique
  inputAssets  String[] // signed URLs
  params       Json // style params, text content, duration, etc.
  status       GenerationStatus @default(pending)
  provider     String? // "mock" | "ai-provider-x" | "manual-team"
  resultUrl    String?
  failedReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum GenerationStatus {
  pending
  in_progress
  completed
  failed
}

model ReviewRecord {
  id           String       @id @default(cuid())
  orderId      String
  reviewType   ReviewType
  result       ReviewResult
  reviewerNote String?
  createdAt    DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum ReviewType {
  auto_keyword
  auto_image
  manual
}

enum ReviewResult {
  approved
  rejected
  flagged
}

// ─── Phase 2 placeholders (tables reserved, no business logic) ───────────────

model Photographer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  region    String?
  rating    Float?
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())

  bookings Booking[]
}

model Booking {
  id             String   @id @default(cuid())
  userId         String
  photographerId String
  scheduledAt    DateTime
  location       String?
  status         String   @default("pending")
  priceCents     Int      @default(0)
  createdAt      DateTime @default(now())

  photographer Photographer @relation(fields: [photographerId], references: [id])
}

// ─── Customer support ────────────────────────────────────────────────────────

model Ticket {
  id        String       @id @default(cuid())
  orderId   String       @unique
  subject   String
  status    TicketStatus @default(open)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}
